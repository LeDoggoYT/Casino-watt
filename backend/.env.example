PORT=3000
# Für den eigenen PC: 127.0.0.1. In Docker oder auf einem VPS: 0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_ORIGINS=https://wigipedia.netlify.app,http://127.0.0.1:5501,http://127.0.0.1:8080,http://localhost:5501,http://localhost:8080
# Nur für den optionalen Docker/Caddy-Produktivbetrieb: api.deine-domain.de
API_DOMAIN=api.deine-domain.de
DATABASE_PATH=./data/watt-casino.sqlite
SESSION_DAYS=30
BCRYPT_ROUNDS=12
TRUST_PROXY=0
ADMIN_PASSWORD=2011
